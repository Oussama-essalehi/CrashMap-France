	partition fact_vehicle = m
		mode: import
		source =
				let
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & "\",
				    Source = Csv.Document(File.Contents(Folder & "fact_vehicle.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"vehicle_key", type text},
				        {"accident_id", Int64.Type},
				        {"catv", Int64.Type},
				        {"fixed_obstacle", type text},
				        {"mobile_obstacle", type text},
				        {"impact_point", type text},
				        {"maneuver", type text},
				        {"engine", type text},
				        {"n_users", Int64.Type},
				        {"n_killed", Int64.Type},
				        {"n_hospitalized", Int64.Type},
				        {"n_lightly_injured", Int64.Type}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

