/// Calendrier continu 2019-2024 (table de dates marquée).
table dim_date
	lineageTag: 40b33395-fdf8-53a0-8fc1-fb7f6500f721
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5306b9a4-bea6-5dc4-aa1d-3998423944e8
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	column date
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		lineageTag: e3dc691f-61db-560f-9c83-608f2fa0976b
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 1603f153-ed33-5218-a41c-e92217379e52
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column quarter
		dataType: int64
		formatString: 0
		lineageTag: 1f3a37be-81c7-5d0a-a06f-7d994180d3d3
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column month
		dataType: int64
		formatString: 0
		lineageTag: a9072fee-8ad2-51f2-8e94-340799c954fd
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column month_name
		dataType: string
		lineageTag: 4af7f5a4-e611-50fd-a2f0-605b7f3c2105
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

	column year_month
		dataType: string
		lineageTag: 95e577f0-7d33-5085-a2ef-291d374ad4e9
		summarizeBy: none
		sourceColumn: year_month

		annotation SummarizationSetBy = Automatic

	column day
		dataType: int64
		formatString: 0
		lineageTag: 3f8b2406-a192-5d2e-8b15-60d63cbd2ea9
		summarizeBy: none
		sourceColumn: day

		annotation SummarizationSetBy = Automatic

	column day_of_week
		dataType: int64
		formatString: 0
		lineageTag: 4bb05170-34b1-5f71-96a7-940f9e80df8a
		summarizeBy: none
		sourceColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column weekday_name
		dataType: string
		lineageTag: 53af232d-78f8-5b4c-9b21-b6068c76c72b
		summarizeBy: none
		sourceColumn: weekday_name
		sortByColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column is_weekend
		dataType: boolean
		lineageTag: d0af419e-0dd9-5cda-b590-7241f6b1885b
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = Automatic

	column is_covid_year
		dataType: boolean
		lineageTag: 51a30ee9-2bff-565e-9bbe-09a9cbabfefe
		summarizeBy: none
		sourceColumn: is_covid_year

		annotation SummarizationSetBy = Automatic

	partition dim_date = m
		mode: import
		source =
				let
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & "\",
				    Source = Csv.Document(File.Contents(Folder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"date_key", Int64.Type},
				        {"date", type date},
				        {"year", Int64.Type},
				        {"quarter", Int64.Type},
				        {"month", Int64.Type},
				        {"month_name", type text},
				        {"year_month", type text},
				        {"day", Int64.Type},
				        {"day_of_week", Int64.Type},
				        {"weekday_name", type text},
				        {"is_weekend", type logical},
				        {"is_covid_year", type logical}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
