	partition fact_victim = m
		mode: import
		source =
				let
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & "\",
				    Source = Csv.Document(File.Contents(Folder & "fact_victim.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"victim_id", type text},
				        {"accident_id", Int64.Type},
				        {"vehicle_key", type text},
				        {"user_type_key", Int64.Type},
				        {"catv", Int64.Type},
