				        {"age", Int64.Type},
				        {"age_band", type text},
				        {"age_band_order", Int64.Type},
				        {"trip_purpose", type text},
				        {"equipment_known", type logical},
				        {"seatbelt_worn", type logical},
				        {"helmet_worn", type logical}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
