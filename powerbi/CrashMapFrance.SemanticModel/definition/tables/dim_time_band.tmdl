	partition dim_time_band = m
		mode: import
		source =
				let
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & "\",
				    Source = Csv.Document(File.Contents(Folder & "dim_time_band.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"hour", Int64.Type},
				        {"hour_label", type text},
				        {"time_band", type text},
				        {"time_band_order", Int64.Type}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

