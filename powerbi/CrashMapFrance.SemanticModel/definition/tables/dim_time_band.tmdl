/// Heure de la journée et tranche horaire (nuit, matin, journée, soirée).
table dim_time_band
	lineageTag: c241a45e-8743-55b5-aba6-1deb6ba0e266

	column hour
		dataType: int64
		formatString: 0
		lineageTag: 700c38ab-ddad-5dfe-9329-73f4c95f6d7c
		summarizeBy: none
		sourceColumn: hour

		annotation SummarizationSetBy = Automatic

	column hour_label
		dataType: string
		lineageTag: 7348d877-b0a4-52cc-9eb2-e782bc8b2dd0
		summarizeBy: none
		sourceColumn: hour_label
		sortByColumn: hour

		annotation SummarizationSetBy = Automatic

	column time_band
		dataType: string
		lineageTag: 27e5c79e-ffcc-5a46-858b-0ebcf4edfb1d
