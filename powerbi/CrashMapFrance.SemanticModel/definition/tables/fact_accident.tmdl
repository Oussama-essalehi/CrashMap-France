	partition fact_accident = m
		mode: import
		source =
				let
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & "\",
				    Source = Csv.Document(File.Contents(Folder & "fact_accident.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
