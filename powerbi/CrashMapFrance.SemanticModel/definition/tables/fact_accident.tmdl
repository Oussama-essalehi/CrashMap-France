				        {"n_users", Int64.Type},
				        {"n_victims", Int64.Type},
				        {"n_killed", Int64.Type},
				        {"n_hospitalized", Int64.Type},
				        {"n_lightly_injured", Int64.Type},
				        {"n_unhurt", Int64.Type},
				        {"fatal", type logical},
				        {"serious", type logical},
				        {"pedestrian_involved", type logical},
				        {"two_wheeler_involved", type logical},
				        {"motorised_two_wheeler_involved", type logical},
				        {"bicycle_involved", type logical},
				        {"personal_mobility_involved", type logical},
				        {"heavy_vehicle_involved", type logical},
				        {"lat", type number},
				        {"lon", type text},
				        {"coord_precise", type logical}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

