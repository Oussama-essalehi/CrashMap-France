	partition dim_road = m
		mode: import
		source =
				let
				    Folder = Text.TrimEnd(DataFolder, {"\", "/"}) & "\",
				    Source = Csv.Document(File.Contents(Folder & "dim_road.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {
				        {"road_key", Int64.Type},
				        {"catr", Int64.Type},
				        {"catr_label", type text},
				        {"vma_band", type text},
				        {"vma_band_order", Int64.Type},
				        {"plan", Int64.Type},
				        {"plan_label", type text},
				        {"intersection", Int64.Type},
				        {"intersection_label", type text}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
