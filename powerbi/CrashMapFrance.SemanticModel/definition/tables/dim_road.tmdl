		annotation SummarizationSetBy = Automatic

	column vma_band
		dataType: string
		lineageTag: 8fc53490-e71b-5a3a-8bb7-40db39747abb
		summarizeBy: none
		sourceColumn: vma_band
		sortByColumn: vma_band_order

		annotation SummarizationSetBy = Automatic

	column vma_band_order
